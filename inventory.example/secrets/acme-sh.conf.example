# Optional. Rename to acme-sh.conf to use it: 6-acme-sh.yaml then writes it into
# /root/.acme.sh/account.conf (set or rotate credentials). Without it, the server's
# credentials are kept, or the run prompts for each key in acme_dns_cred_keys.
# Only for DNS-01. Example for the dns_cloudns plugin (acme_dns_plugin in the
# inventory); other plugins use their own SAVED_* keys. Prefer a ClouDNS SUB-account scoped to only the zones
# acme.sh needs (least privilege) over the master API user.

SAVED_CLOUDNS_SUB_AUTH_ID='your-cloudns-sub-auth-id'
SAVED_CLOUDNS_AUTH_PASSWORD='your-cloudns-api-password'  # betterleaks:allow

# Alternative: master API user instead of a sub-account —
# SAVED_CLOUDNS_AUTH_ID='your-cloudns-auth-id'
